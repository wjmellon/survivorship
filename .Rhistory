) +
geom_abline(
intercept = overall$stats$intercept,
slope     = overall$stats$slope,
color = "grey", linewidth = 1.2
)
# Per-class lines (show.legend = FALSE keeps the legend exactly as before)
if (nrow(class_lines) > 0) {
p <- p + geom_segment(
data = class_lines,
aes(x = x, xend = xend, y = y, yend = yend, color = Class),
inherit.aes = FALSE, linewidth = 1, show.legend = FALSE
)
}
p <- p +
scale_y_continuous(labels = scales::percent) +
labs(x = xlab, y = ylab, color = "Class", title = title) +
theme_cowplot(12) +
theme(legend.position = "right")
print(p)
ggsave(filename = file, plot = p, width = 10, height = 8,
limitsize = FALSE, bg = "white")
invisible(p)
}
