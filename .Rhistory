# Read your full life table
df <- read_csv("Fall 2025/Siler/life_tables_all_species.csv")
# Pick one species name exactly as it appears in your data
species_name <- "Gallus gallus"   # ← change this to the species you want
# Filter for that species
df_sp <- df %>% filter(Species == species_name)
# Function to fit Siler model
fit_siler_for_species <- function(df) {
# Fit Siler model using starting parameters
res <- tryCatch({
fitSiler(c(0.1, 0.1, 0.01, 0.1, 0.01), df$q_x)
}, error = function(e) {
return(NULL)
})
return(res)
}
# Run model for your chosen species
res <- fit_siler_for_species(df_sp)
# Print results
print(res)
# --- Loop through all species ---
siler_results <- df %>%
group_by(Species) %>%
group_map(~ {
model <- fit_siler_for_species(.x)
if (!is.null(model)) {
tibble(
Species = unique(.x$Species),
a = model$parameters["a"],
b = model$parameters["b"],
c = model$parameters["c"],
d = model$parameters["d"],
e = model$parameters["e"]
)
} else {
tibble(
Species = unique(.x$Species),
a = NA, b = NA, c = NA, d = NA, e = NA
)
}
}) %>%
bind_rows()
