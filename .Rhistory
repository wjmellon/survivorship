# Define color mapping
curve_colors <- c(
"Type I" = "blue",
"Trending toward Type I" = "skyblue",
"Type II" = "green",
"Trending toward Type III" = "lightcoral",
"Type III" = "red"
)
plot_data$Curve.Type <- factor(
plot_data$Curve.Type,
levels = c("Type I", "Trending toward Type I", "Type II", "Trending toward Type III", "Type III")
)
ggplot(plot_data, aes(x = Curve.Type, y = Log10_Prevalence)) +
geom_jitter(aes(color = Prevalence_Type), width = 0.2, height = 0, alpha = 0.7, size = 2) +
stat_summary(fun = mean, geom = "point", shape = 18, size = 4, aes(group = Prevalence_Type), position = position_dodge(width = 0.4), color = "black") + # Set color here
stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.2, aes(group = Prevalence_Type), position = position_dodge(width = 0.4)) +
facet_wrap(~ Prevalence_Type) +
scale_color_manual(values = c("Malignant_Prev" = "darkred", "Benign_Prev" = "darkblue", "Neoplasia_Prev" = "darkgreen")) +
labs(
title = "Log10 Prevalence by Survivorship Curve Type",
x = "Survivorship Curve Type",
y = "Log10 Prevalence",
color = "Prevalence Type"
) +
theme_minimal() +
theme(legend.position = "bottom")
library(ggplot2)
library(dplyr)
library(tidyr)
# Load datasets
data <- read.csv("records.csv")
table_data <- read.csv("Updated Survivorship Curves/Species Survivorship Curve Analysis/DataSheet w All Species Survivorship Curves - Sheet1.csv", skip = 1, header = TRUE)
# Filter and calculate prevalence per species
prevalence_data <- data %>%
filter(!is.na(Malignant)) %>%
group_by(Species) %>%
summarise(
Total = n(),
Malignant = sum(Malignant == 1),
Benign = sum(Malignant == 0),
Malignant_Prev = Malignant / Total,
Benign_Prev = Benign / Total,
Neoplasia_Prev = (Malignant + Benign) / Total,
.groups = 'drop'
)
# Merge with curve types
merged_data <- prevalence_data %>%
inner_join(table_data %>% select(`Scientific.Name`, `Curve.Type`), by = c("Species" = "Scientific.Name"))
# Reshape for plotting (long format)
plot_data <- merged_data %>%
pivot_longer(cols = c(Malignant_Prev, Benign_Prev, Neoplasia_Prev),
names_to = "Prevalence_Type",
values_to = "Prevalence") %>%
mutate(Log10_Prevalence = log10(Prevalence))
# Define color mapping
curve_colors <- c(
"Type I" = "blue",
"Trending toward Type I" = "skyblue",
"Type II" = "green",
"Trending toward Type III" = "lightcoral",
"Type III" = "red"
)
plot_data$Curve.Type <- factor(
plot_data$Curve.Type,
levels = c("Type I", "Trending toward Type I", "Type II", "Trending toward Type III", "Type III")
)
ggplot(plot_data, aes(x = Curve.Type, y = Log10_Prevalence)) +
geom_jitter(aes(color = Prevalence_Type), width = 0.2, height = 0, alpha = 0.7, size = 2) +
stat_summary(fun = mean, geom = "point", shape = 18, size = 4, aes(group = Prevalence_Type), position = position_dodge(width = 0.4), color = "gray") + # Set color here
stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.2, aes(group = Prevalence_Type), position = position_dodge(width = 0.4)) +
facet_wrap(~ Prevalence_Type) +
scale_color_manual(values = c("Malignant_Prev" = "darkred", "Benign_Prev" = "darkblue", "Neoplasia_Prev" = "darkgreen")) +
labs(
title = "Log10 Prevalence by Survivorship Curve Type",
x = "Survivorship Curve Type",
y = "Log10 Prevalence",
color = "Prevalence Type"
) +
theme_minimal() +
theme(legend.position = "bottom")
