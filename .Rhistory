Power [label='Power: P = T × ω']
}
")
# Install and load the igraph package if you haven't already
# install.packages("igraph")
library(igraph)
# Create an empty graph
mind_map <- graph.empty(directed = TRUE)
# Function to add a main topic and its branches
add_topic <- function(graph, topic_name, what, how, takeaway, example) {
graph <- add.vertices(graph, 1, name = topic_name, type = "main")
graph <- add.vertices(graph, 4,
name = c("What", "How", "Key Takeaway", "Example"),
type = "aspect")
graph <- add.edges(graph, c(topic_name, "What",
topic_name, "How",
topic_name, "Key Takeaway",
topic_name, "Example"))
V(graph)[V(graph)$name == "What"]$description <- what
V(graph)[V(graph)$name == "How"]$description <- how
V(graph)[V(graph)$name == "Key Takeaway"]$description <- takeaway
V(graph)[V(graph)$name == "Example"]$description <- example
return(graph)
}
# 1. Teaming
mind_map <- add_topic(mind_map, "Teaming",
"The process of individuals working collaboratively towards a common goal.",
"Understanding team development stages and effective collaboration models.",
"Effective teamwork is crucial for project success.",
"A project team successfully navigating the storming phase to achieve synergy.")
# 1a. Stages of Team Development (Tuckman’s Model)
mind_map <- add.vertices(mind_map, 1, name = "Tuckman's Model", type = "subtopic")
mind_map <- add.edges(mind_map, c("Teaming", "Tuckman's Model"))
V(mind_map)[V(mind_map)$name == "Tuckman's Model"]$description <- "Forming, Storming, Norming, Performing, Adjourning."
V(mind_map)[V(mind_map)$name == "Tuckman's Model"]$how <- "Understanding these stages helps anticipate and manage team dynamics."
V(mind_map)[V(mind_map)$name == "Tuckman's Model"]$takeaway <- "Teams evolve through predictable stages."
V(mind_map)[V(mind_map)$name == "Tuckman's Model"]$example <- "A new project team initially getting to know each other (Forming)."
# 1b. GRPI Model
mind_map <- add.vertices(mind_map, 1, name = "GRPI Model", type = "subtopic")
mind_map <- add.edges(mind_map, c("Teaming", "GRPI Model"))
V(mind_map)[V(mind_map)$name == "GRPI Model"]$description <- "Goals, Roles, Processes, Interpersonal Relationships."
V(mind_map)[V(mind_map)$name == "GRPI Model"]$how <- "A framework for analyzing team effectiveness."
V(mind_map)[V(mind_map)$name == "GRPI Model"]$takeaway <- "Clear goals, roles, processes, and positive relationships are vital."
V(mind_map)[V(mind_map)$name == "GRPI Model"]$example <- "Defining clear roles and responsibilities within a team (Roles)."
# 2. The Design Process
mind_map <- add_topic(mind_map, "The Design Process",
"A systematic approach to problem-solving and creating solutions.",
"Iterative steps involving understanding, ideation, prototyping, and testing.",
"A structured process ensures comprehensive and effective design outcomes.",
"Following the design process to develop a new user interface for an application.")
# 2a. Know the steps of the design process
mind_map <- add.vertices(mind_map, 1, name = "Steps of Design Process", type = "subtopic")
mind_map <- add.edges(mind_map, c("The Design Process", "Steps of Design Process"))
V(mind_map)[V(mind_map)$name == "Steps of Design Process"]$description <- "Define, Research, Ideate, Prototype, Test, Implement."
V(mind_map)[V(mind_map)$name == "Steps of Design Process"]$how <- "Understanding the sequence and importance of each step."
V(mind_map)[V(mind_map)$name == "Steps of Design Process"]$takeaway <- "Each step contributes to a well-informed design."
V(mind_map)[V(mind_map)$name == "Steps of Design Process"]$example <- "Conducting user interviews during the Research phase."
# 2b. How to write a problem definition statement
mind_map <- add.vertices(mind_map, 1, name = "Problem Definition", type = "subtopic")
mind_map <- add.edges(mind_map, c("The Design Process", "Problem Definition"))
V(mind_map)[V(mind_map)$name == "Problem Definition"]$description <- "A clear and concise statement outlining the problem to be solved."
V(mind_map)[V(mind_map)$name == "Problem Definition"]$how <- "Using the 'Who, What, Where, When, Why, How' framework."
V(mind_map)[V(mind_map)$name == "Problem Definition"]$takeaway <- "A well-defined problem is the foundation of effective design."
V(mind_map)[V(mind_map)$name == "Problem Definition"]$example <- "'Students need a more efficient way to access course materials online because the current platform is disorganized and difficult to navigate.'"
# 2c. How to write a technical requirement
mind_map <- add.vertices(mind_map, 1, name = "Technical Requirement", type = "subtopic")
mind_map <- add.edges(mind_map, c("The Design Process", "Technical Requirement"))
V(mind_map)[V(mind_map)$name == "Technical Requirement"]$description <- "Specific, measurable, achievable, relevant, and time-bound (SMART) criteria for the design solution."
V(mind_map)[V(mind_map)$name == "Technical Requirement"]$how <- "Quantifying desired performance, features, and constraints."
V(mind_map)[V(mind_map)$name == "Technical Requirement"]$takeaway <- "Technical requirements guide the engineering and implementation of the design."
V(mind_map)[V(mind_map)$name == "Technical Requirement"]$example <- "'The system shall respond to user input within 2 seconds.'"
# 2d. Difference between requirements and criteria
mind_map <- add.vertices(mind_map, 1, name = "Req vs Criteria", type = "subtopic")
mind_map <- add.edges(mind_map, c("The Design Process", "Req vs Criteria"))
V(mind_map)[V(mind_map)$name == "Req vs Criteria"]$description <- "Requirements are mandatory; criteria are desirable qualities for evaluation."
V(mind_map)[V(mind_map)$name == "Req vs Criteria"]$how <- "Identifying essential functionalities versus preferred attributes."
V(mind_map)[V(mind_map)$name == "Req vs Criteria"]$takeaway <- "Distinguishing between must-haves and nice-to-haves is crucial for decision-making."
V(mind_map)[V(mind_map)$name == "Req vs Criteria"]$example <- "A requirement might be 'The device must be waterproof,' while a criterion could be 'The device should have a battery life of at least 10 hours.'"
# 2e. How to use an AHP
mind_map <- add.vertices(mind_map, 1, name = "AHP", type = "subtopic")
mind_map <- add.edges(mind_map, c("The Design Process", "AHP"))
V(mind_map)[V(mind_map)$name == "AHP"]$description <- "Analytic Hierarchy Process: a structured technique for dealing with complex decisions by comparing criteria pairwise."
V(mind_map)[V(mind_map)$name == "AHP"]$how <- "Structuring criteria in a hierarchy, making pairwise comparisons, and calculating weights to rank alternatives."
V(mind_map)[V(mind_map)$name == "AHP"]$takeaway <- "AHP provides a rational framework for multi-criteria decision analysis."
V(mind_map)[V(mind_map)$name == "AHP"]$example <- "Using AHP to decide which material to use for a product based on factors like cost, durability, and aesthetics."
# 2f. How to use a design decision matrix
mind_map <- add.vertices(mind_map, 1, name = "Decision Matrix", type = "subtopic")
mind_map <- add.edges(mind_map, c("The Design Process", "Decision Matrix"))
V(mind_map)[V(mind_map)$name == "Decision Matrix"]$description <- "A table used to evaluate and compare different design options against a set of criteria."
V(mind_map)[V(mind_map)$name == "Decision Matrix"]$how <- "Listing options and criteria, assigning weights to criteria, scoring options against each criterion, and calculating a total score."
V(mind_map)[V(mind_map)$name == "Decision Matrix"]$takeaway <- "A decision matrix helps in objectively comparing and selecting the best design alternative."
V(mind_map)[V(mind_map)$name == "Decision Matrix"]$example <- "Comparing three different robot arm designs based on criteria like reach, payload capacity, and cost."
# Continue adding other major topics and their sub-branches in a similar fashion...
# (I will add a few more to illustrate the structure)
# 3. Engineering Models
mind_map <- add_topic(mind_map, "Engineering Models",
"Simplified representations of real-world systems or phenomena.",
"Using mathematical equations, diagrams, or physical prototypes to analyze and predict behavior.",
"Models are essential tools for understanding, designing, and testing complex engineering systems.",
"A computer simulation of airflow over an aircraft wing.")
# 3a. What is a model? Why do we use them?
mind_map <- add.vertices(mind_map, 1, name = "What/Why Models?", type = "subtopic")
mind_map <- add.edges(mind_map, c("Engineering Models", "What/Why Models?"))
V(mind_map)[V(mind_map)$name == "What/Why Models?"]$description <- "A representation used to understand, predict, and control a system. Used for analysis, design, and testing without building the real thing."
V(mind_map)[V(mind_map)$name == "What/Why Models?"]$how <- "Creating abstractions of reality with varying levels of complexity."
V(mind_map)[V(mind_map)$name == "What/Why Models?"]$takeaway <- "Models save time, cost, and allow for exploration of different scenarios."
V(mind_map)[V(mind_map)$name == "What/Why Models?"]$example <- "Using a mathematical model to predict the trajectory of a projectile."
# 3b. Types of Models
mind_map <- add.vertices(mind_map, 1, name = "Types of Models", type = "subtopic")
mind_map <- add.edges(mind_map, c("Engineering Models", "Types of Models"))
V(mind_map)[V(mind_map)$name == "Types of Models"]$description <- "Physical, mathematical, computational, graphical."
V(mind_map)[V(mind_map)$name == "Types of Models"]$how <- "Categorizing models based on their form and how they are used."
V(mind_map)[V(mind_map)$name == "Types of Models"]$takeaway <- "Different types of models are suitable for different purposes."
V(mind_map)[V(mind_map)$name == "Types of Models"]$example <- "A scale model of a building (physical), a set of differential equations describing a circuit (mathematical)."
