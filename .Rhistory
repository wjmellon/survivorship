install.packages("fmsb")
load("fmsb")
library(fmsb)
library(fmsb)
# Example life table with qx (probability of dying between x and x+1)
life_table <- data.frame(
x  = 0:10,                     # ages 0 through 10
qx = c(0.10, 0.11, 0.10, 0.07, 0.07,
0.15, 0.25, 0.35, 0.40, 0.58, 1.00) # must end with 1
)
# Convert qx into survivorship lx
lx <- cumprod(c(1, 1 - life_table$qx[-length(life_table$qx)]))
life_table$lx <- lx
# Inspect life table
print(life_table)
# Fit Siler model using lx
res <- fitSiler(NULL, life_table$lx)
# Show results
print(res)
# Fit Siler model using lx
res <- fitSiler(NULL, life_table$lx)
library(fmsb)
# Example life table with qx
life_table <- data.frame(
x  = 0:10,
qx = c(0.10, 0.11, 0.10, 0.07, 0.07,
0.15, 0.25, 0.35, 0.40, 0.58, 1.00)
)
# Compute lx properly
lx <- numeric(length(life_table$qx))
lx[1] <- 1  # at birth
for (i in 2:length(lx)) {
lx[i] <- lx[i-1] * (1 - life_table$qx[i-1])
}
life_table$lx <- lx
print(life_table)
# Try fitting with default start values
res <- fitSiler(NULL, life_table$lx)
# Example life table for a species
# x = age (years), lx = proportion surviving
life_table <- data.frame(
x = 0:10,                      # ages 0 through 10
lx = c(1.00, 0.90, 0.80, 0.72, 0.65,
0.55, 0.40, 0.25, 0.12, 0.05, 0.00)
)
# Fit the Siler model
res <- fitSiler(NULL, life_table$lx)
library(fmsb)
life_table <- data.frame(
x  = 0:10,
qx = c(0.10, 0.11, 0.10, 0.07, 0.07,
0.15, 0.25, 0.35, 0.40, 0.58, 1.00)
)
# Build lx from qx
lx <- numeric(length(life_table$qx))
lx[1] <- 1
for (i in 2:length(lx)) {
lx[i] <- lx[i-1] * (1 - life_table$qx[i-1])
}
life_table$lx <- lx
plot(life_table$x, life_table$lx, type="b",
main="Survivorship curve", xlab="Age", ylab="lx")
# Safer fit with starting parameters
res <- fitSiler(c(0.1, 0.1, 0.01, 0.1, 0.01), life_table$lx)
print(res)
# Predict survivorship from fitted Siler params
pred_lx <- Siler(x = life_table$x, param = res[1:5], type = "lx")
