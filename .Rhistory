ggtitle(paste("Survivorship Curve -", spec)) +
xlab("Proportion of Maximum Lifespan") +
ylab("Proportion Alive") +
theme_cowplot(12) +
theme(plot.title = element_text(size = 10)) +
scale_y_log10()
