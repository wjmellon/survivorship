# Run PGLS Function
library(phytools)
library(geiger)
library(caper)
library(tidyverse)
library(cowplot)
library(ggplot2)
library(rr2)
library(nlme)
library(scales)
## Read phylogenetic tree in
tree <- read.tree("min20Fixed516.nwk")
# Class colors (ggplot default hue palette, so they match your earlier figures)
class_colors <- c(
"Amphibia" = "#F8766D",
"Aves"     = "#7CAE00",
"Mammalia" = "#00BFC4",
"Reptilia" = "#C77CFF"
)
# Minimum species a class needs before we fit its own PGLS.
# Pagel's lambda is unreliable with very few tips, so small classes
# (probably Amphibia) are skipped and reported in the console.
MIN_SPECIES <- 10
# Collects stats for every model fit (overall + per class)
all_results <- list()
# -------------------------------------------------------------------------
# Helper: drop rows missing x / y / n, then prune data + tree so they match
# -------------------------------------------------------------------------
prep_data <- function(data, tree, xvar, yvar) {
data <- data[complete.cases(data[, c(xvar, yvar, "n")]), ]
data$Species <- gsub(" ", "_", data$Species)
pruned.tree <- drop.tip(tree, setdiff(tree$tip.label, data$Species))
data <- data[data$Species %in% pruned.tree$tip.label, ]
rownames(data) <- data$Species
SE <- setNames(data$SE_simple, data$Species)[rownames(data)]
list(data = data, tree = pruned.tree, SE = SE)
}
# -------------------------------------------------------------------------
# Helper: fit one PGLS and pull out the stats
# -------------------------------------------------------------------------
fit_pgls <- function(data, tree, xvar, yvar, label) {
prep <- prep_data(data, tree, xvar, yvar)
form <- as.formula(paste(yvar, "~", xvar))
model <- tryCatch(
pglsSEyPagel(form, data = prep$data, tree = prep$tree,
se = prep$SE, method = "ML"),
error = function(e) {
message("  ! PGLS failed for ", label, ": ", conditionMessage(e))
NULL
}
)
if (is.null(model)) return(NULL)
tt     <- summary(model)$tTable
# same lambda extraction as your original script
lambda <- tryCatch(as.numeric(summary(model)$modelStruct$corStruct[1]),
error = function(e) NA)
r2     <- tryCatch(as.numeric(R2(phy = prep$tree, model)[3]),
error = function(e) NA)
stats <- tibble(
model     = label,
x         = xvar,
y         = yvar,
n_species = nrow(prep$data),
intercept = tt[1, 1],
slope     = tt[2, 1],
p_value   = tt[2, 4],
R2        = r2,
lambda    = lambda
)
all_results[[label]] <<- stats
list(model = model, data = prep$data, stats = stats)
}
# -------------------------------------------------------------------------
# Helper: fit overall + per-class PGLS, then plot
#   - overall regression: grey line across the full plot (same as before)
#   - per-class regressions: lines in that class's color, drawn only
#     over the x-range that class actually covers
#   - size legend uses fixed clean breaks (1,000 / 2,500 / 5,000 / 7,500)
# -------------------------------------------------------------------------
pgls_plot <- function(data, tree, xvar, yvar, xlab, ylab, title, file) {
cat("\n==========", yvar, "~", xvar, "==========\n")
# Overall model
overall <- fit_pgls(data, tree, xvar, yvar, paste0(yvar, "~", xvar, " | All"))
if (is.null(overall)) return(invisible(NULL))
print(summary(overall$model))
plot_data <- overall$data
# Per-class models
class_lines <- list()
for (cl in names(class_colors)) {
sub <- plot_data[plot_data$Class == cl, ]
if (nrow(sub) < MIN_SPECIES) {
cat("  - Skipping", cl, "(only", nrow(sub), "species)\n")
next
}
fit <- fit_pgls(sub, tree, xvar, yvar, paste0(yvar, "~", xvar, " | ", cl))
if (is.null(fit)) next
xr <- range(fit$data[[xvar]])
class_lines[[cl]] <- tibble(
Class = cl,
x     = xr[1],
xend  = xr[2],
y     = fit$stats$intercept + fit$stats$slope * xr[1],
yend  = fit$stats$intercept + fit$stats$slope * xr[2]
)
}
class_lines <- bind_rows(class_lines)
p <- ggplot(plot_data, aes(x = .data[[xvar]], y = .data[[yvar]],
color = Class, size = n)) +
geom_point(alpha = 1) +
scale_color_manual(values = class_colors) +
scale_size_continuous(
range    = c(3, 8),
breaks   = c(1000, 2500, 5000, 7500),
labels   = scales::comma,
limits   = c(0, 7500),
name     = "Sample Size (n)"
) +
guides(
color = guide_legend(override.aes = list(size = 4), order = 1),
size  = guide_legend(override.aes = list(color = "grey40"), order = 2)
) +
geom_abline(
intercept = overall$stats$intercept,
slope     = overall$stats$slope,
color = "grey", linewidth = 1.2
)
# Per-class lines (show.legend = FALSE keeps the legend exactly as before)
if (nrow(class_lines) > 0) {
p <- p + geom_segment(
data = class_lines,
aes(x = x, xend = xend, y = y, yend = yend, color = Class),
inherit.aes = FALSE, linewidth = 1, show.legend = FALSE
)
}
p <- p +
scale_y_continuous(labels = scales::percent) +
labs(x = xlab, y = ylab, color = "Class", title = title) +
theme_cowplot(12) +
theme(legend.position = "right")
print(p)
ggsave(filename = file, plot = p, width = 10, height = 8,
limitsize = FALSE, bg = "white")
invisible(p)
}
# #########################################################################
# PART 1: DISTANCE FROM TYPE II SURVIVORSHIP (abs_shape)
# #########################################################################
data <- read.csv("Spring 2026/final_clean_data_w_multivariate.csv") %>%
mutate(abs_shape = abs(shape_value),
SE_simple = 1 / sqrt(n))
summary(data$n)   # sanity check
pgls_plot(data, tree, "abs_shape", "neoplasia_prevalence",
"Distance from Type II Survivorship", "Neoplasia Prevalence (%)",
"Neoplasia Prevalence vs. Distance from Type II Survivorship",
"abs_shape_neoplasia.png")
pgls_plot(data, tree, "abs_shape", "cancer_prevalence",
"Distance from Type II Survivorship", "Cancer Prevalence (%)",
"Cancer Prevalence vs. Distance from Type II Survivorship",
"abs_shape_cancer.png")
# #########################################################################
# PART 2: ALL SILER PARAMETERS
# #########################################################################
data <- read.csv("Fall 2025/Siler/siler_parameters_all_min50species.csv") %>%
filter(FLAG == "0") %>%
mutate(SE_simple = 1 / sqrt(n))
summary(data$n)   # sanity check
# Siler parameters -> axis labels. Edit names here if your columns differ.
siler_params <- c(
a1 = "Initial Juvenile Mortality Risk (a1)",
b1 = "Rate of Decline in Juvenile Mortality Risk (b1)",
a2 = "Age-Independent Mortality Risk (a2)",
a3 = "Initial Senescent Mortality Risk (a3)",
