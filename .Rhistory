geom_point(alpha = 1) +
scale_size_continuous(range = c(3, 8), guide = "none") +  # hide size legend
geom_abline(
intercept = coef(abs_cancer)[1],
slope = coef(abs_cancer)[2],
color = 'grey', size = 1.2
) +
theme_minimal() +
labs(
x = "Distance from Type II Survivorship",
y = "Cancer Prevalence (%)",
color = "Class",
