library(dplyr)
library(fmsb)
library(readr)
# Load full life table
df <- read_csv("Fall 2025/Siler/life_tables_all_species.csv")
# Get all unique species
species_list <- unique(df$Species)
# Create an empty list to store results
results_list <- list()
# Loop over species
for (sp in species_list) {
# Filter for this species
df_sp <- df %>% filter(Species == sp)
# Remove invalid q_x values
df_sp <- df_sp %>% filter(!is.na(q_x), q_x >= 0, q_x <= 1)
# Skip species with too few points
if (nrow(df_sp) < 5) {
results_list[[sp]] <- data.frame(Species = sp, a=NA, b=NA, c=NA, d=NA, e=NA, FLAG=NA)
next
}
# First attempt at fitting
res <- fitSiler(c(0.1, 0.1, 0.01, 0.1, 0.01), df_sp$q_x)
FLAG <- res[7]
# Iterate until convergence (FLAG == 0)
while (FLAG > 0) {
res <- fitSiler(res[1:5], df_sp$q_x)
FLAG <- res[7]
}
# Store results
results_list[[sp]] <- data.frame(
Species = sp,
a = res[1],
b = res[2],
c = res[3],
d = res[4],
e = res[5],
FLAG = res[7]
)
cat("Finished:", sp, "FLAG =", FLAG, "\n")  # optional progress print
}
# Combine into one data frame
siler_results <- do.call(rbind, results_list)
# View or save
View(siler_results)
print(siler_results)
library(dplyr)
library(fmsb)
library(readr)
# Load your life table
df <- read_csv("Fall 2025/Siler/life_tables_all_species.csv")
# Get all unique species names
species_list <- unique(df$Species)
# Create an empty results list
results_list <- list()
# Loop through species
for (sp in species_list) {
cat("Fitting:", sp, "...\n")
# Filter for this species
df_sp <- df %>% filter(Species == sp)
# Skip if too few data points
if (nrow(df_sp) < 5) {
results_list[[sp]] <- data.frame(Species = sp, a=NA, b=NA, c=NA, d=NA, e=NA, FLAG=NA)
next
}
# Try fitting model
res <- tryCatch({
fitSiler(c(0.1, 0.1, 0.01, 0.1, 0.01), df_sp$q_x)
}, error = function(e) { NULL })
# If fit failed, skip species
if (is.null(res)) {
results_list[[sp]] <- data.frame(Species = sp, a=NA, b=NA, c=NA, d=NA, e=NA, FLAG=NA)
next
}
FLAG <- res[7]
# Retry until converged or too many attempts
attempts <- 0
while (FLAG > 0 && attempts < 10) {
res <- fitSiler(res[1:5], df_sp$q_x)
FLAG <- res[7]
attempts <- attempts + 1
}
# Store results
results_list[[sp]] <- data.frame(
Species = sp,
a = res[1],
b = res[2],
c = res[3],
d = res[4],
e = res[5],
FLAG = res[7]
)
cat("  Done:", sp, "FLAG =", FLAG, "\n")
}
# Combine into one data frame safely
siler_results <- do.call(rbind, results_list)
# View your results table
View(siler_results)
# Also print to console
print(head(siler_results))
