r.v.siler_a3_cancer <- format(r.v.siler_a3_cancer[3])
r.v.siler_a3_cancer <-signif(as.numeric(r.v.siler_a3_cancer), digits= 2)
ld.v.siler_a3_cancer <- summary(siler_a3_cancer)$modelStruct$corStruct
ld.v.siler_a3_cancer <- signif(ld.v.siler_a3_cancer[1], digits = 2)
p.v.siler_a3_cancer <-summary(siler_a3_cancer)$tTable
p.v.siler_a3_cancer <-signif(p.v.siler_a3_cancer[2,4], digits = 2)
ggplot(data, aes(x = a3, y = cancer_prevalence, color = Class, size = n)) +
