library(dplyr)
library(fmsb)
library(readr)
# Read your full life table
df <- read_csv("Fall 2025/Siler/life_tables_all_species.csv")
# Function to fit Siler model for one species
fit_siler_for_species <- function(df) {
res <- tryCatch({
fitSiler(c(0.1, 0.1, 0.01, 0.1, 0.01), df$lx)
}, error = function(e) {
return(NULL)
})
return(res)
}
# Get unique species names
species_list <- unique(df$Species)
# Initialize list to store results
siler_results <- list()
# Loop through each species
for (sp in species_list) {
# Filter data for this species
df_sp <- df %>% filter(Species == sp)
# Fit Siler model
model <- fit_siler_for_species(df_sp)
# Store results (or NA if fit failed)
if (!is.null(model)) {
siler_results[[sp]] <- data.frame(
Species = sp,
a = model[1],
b = model[2],
c = model[3],
d = model[4],
e = model[5]
)
} else {
siler_results[[sp]] <- data.frame(
Species = sp,
a = NA, b = NA, c = NA, d = NA, e = NA
)
}
}
# Combine all species results into one table
siler_results <- do.call(rbind, siler_results)
# View the table
View(siler_results)
# Read your full life table
df <- read_csv("Fall 2025/Siler/life_tables_all_species.csv")
res <- fitSiler(df$q_x)
FLAG <- res[7]
while (FLAG>0) {
res <- fitSiler(res[1:5], Jlife$qx2005M)
FLAG <- res[7]
