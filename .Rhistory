library(ggplot2)
library(dplyr)
data <- read.csv("condensed_data.csv")
# Scatterplot with linear regression line and size by n
ggplot(data, aes(x = shape_value, y = cancer_prevalence, color = Class)) +
geom_point(aes(size = n), alpha = 0.7) +  # size based on n, slightly transparent
geom_smooth(method = "lm", se = TRUE, color = "black") +   # regression line
scale_size_continuous(range = c(1, 10), breaks = c(100, 200, 300, 400, 500)) +  # scale size
theme_minimal() +
labs(
x = "Survivorship",
y = "Cancer Prevalence (%)",
color = "Class",
size = "Sample Size (n)",
title = "Survivorship vs. Cancer Prevalence"
) +
theme(legend.position = "bottom")
# Run the linear model
model <- lm(cancer_prevalence ~ shape_value, data = data)
# See results
summary(model)
library(readr)
cleanPath_min20_062822 <- read_csv("cleanPath.min20.062822.csv")
View(cleanPath_min20_062822)
library(readr)
condensed_data <- read_csv("condensed_data.csv")
View(condensed_data)
# Load required libraries
library(dplyr)
library(Rage)
library(tibble)
data <- read.csv("records.csv")
# Step 1: Filter dataset
filtered_data <- data %>%
filter(Class %in% c("Mammalia", "Reptilia", "Amphibia", "Aves")) %>%
filter(age_months > 0) %>%
group_by(Species) %>%
filter(n() >= 20) %>%
ungroup()
# Step 2: Calculate neoplasia and cancer prevalence per species
prevalence_data <- filtered_data %>%
group_by(Species, Class) %>%
summarise(
n = n(),  # Number of individuals per species
neoplasia_cases = sum(Malignant >= 0, na.rm = TRUE),   # 0 & 1 = neoplasia
neoplasia_prevalence = neoplasia_cases / n,
cancer_cases = sum(Malignant == 1, na.rm = TRUE),      # 1 = malignant cancer
cancer_prevalence = cancer_cases / n,
max_longevity = max(age_months, na.rm = TRUE),         # needed for relative age
.groups = "drop"
)
# Step 3: Calculate survivorship type for each species
survival_metrics <- filtered_data %>%
group_by(Species) %>%
group_map(~{
df <- .x
species_name <- .y$Species
# Compute relative age (0-1) for this species
df <- df %>%
mutate(relative_age = age_months / max(age_months, na.rm = TRUE))
# Define relative age steps
time_steps <- seq(0, 1, by = 0.01)
# Count individuals alive at each relative age
alive_counts <- sapply(time_steps, function(x) sum(df$relative_age >= x))
# Proportion alive (lx)
lx <- alive_counts / max(alive_counts)
# Compute shape_surv
shape_type <- shape_surv(lx)
# Convert to categorical type
surv_type <- case_when(
shape_type >= 0.3 ~ "Type I",
shape_type >= 0.1 & shape_type < 0.3 ~ "Trending toward Type I",
shape_type > -0.1 & shape_type < 0.1 ~ "Type II",
shape_type > -0.3 & shape_type <= -0.1 ~ "Trending toward Type III",
shape_type <= -0.3 ~ "Type III"
)
tibble(
Species = species_name,
survivorship_type = surv_type,
shape_value = shape_type
)
}) %>%
bind_rows()
# Step 4: Merge prevalence and survival metrics by Species
condensed_data <- prevalence_data %>%
left_join(survival_metrics, by = "Species") %>%
select(
Species,
Class,
n,
neoplasia_prevalence,
cancer_prevalence,
survivorship_type,
shape_value
)
# Step 5: Inspect the combined data (optional)
# View(condensed_data)
view(condensed_data)
final_clean_data <- inner_join(condensed_data, cleanPath_min20_062822, by = "Species")
view(final_clean_data)
# Load required libraries
library(dplyr)
library(Rage)
library(tibble)
data <- read.csv("cleanPath.min20.062822.csv")
# Step 1: Filter dataset
filtered_clean_data <- data %>%
filter(Class %in% c("Mammalia", "Reptilia", "Amphibia", "Aves")) %>%
filter(age_months > 0) %>%
group_by(Species) %>%
filter(n() >= 20) %>%
ungroup()
# Step 2: Calculate neoplasia and cancer prevalence per species
prevalence_clean_data <- filtered_clean_data %>%
group_by(Species, Class) %>%
summarise(
n = n(),  # Number of individuals per species
neoplasia_cases = sum(Malignant >= 0, na.rm = TRUE),   # 0 & 1 = neoplasia
neoplasia_prevalence = neoplasia_cases / n,
cancer_cases = sum(Malignant == 1, na.rm = TRUE),      # 1 = malignant cancer
cancer_prevalence = cancer_cases / n,
max_longevity = max(age_months, na.rm = TRUE),         # needed for relative age
.groups = "drop"
)
prevalence_clean_data <- filtered_clean_data %>%
group_by(Species, Class) %>%
summarise(
n = n(),  # Number of individuals per species
neoplasia_cases = sum(Malignant >= 0, na.rm = TRUE),   # 0 & 1 = neoplasia
neoplasia_prevalence = neoplasia_cases / n,
cancer_cases = sum(Malignant == 1, na.rm = TRUE),      # 1 = malignant cancer
cancer_prevalence = cancer_cases / n,
max_longevity = max(age_months, na.rm = TRUE),         # needed for relative age
.groups = "drop"
)
# Step 3: Calculate survivorship type for each species
survival_clean_metrics <- filtered_clean_data %>%
group_by(Species) %>%
group_map(~{
df <- .x
species_name <- .y$Species
# Compute relative age (0-1) for this species
df <- df %>%
mutate(relative_age = age_months / max(age_months, na.rm = TRUE))
# Define relative age steps
time_steps <- seq(0, 1, by = 0.01)
# Count individuals alive at each relative age
alive_counts <- sapply(time_steps, function(x) sum(df$relative_age >= x))
# Proportion alive (lx)
lx <- alive_counts / max(alive_counts)
# Compute shape_surv
shape_type <- shape_surv(lx)
# Convert to categorical type
surv_type <- case_when(
shape_type >= 0.3 ~ "Type I",
shape_type >= 0.1 & shape_type < 0.3 ~ "Trending toward Type I",
shape_type > -0.1 & shape_type < 0.1 ~ "Type II",
shape_type > -0.3 & shape_type <= -0.1 ~ "Trending toward Type III",
shape_type <= -0.3 ~ "Type III"
)
tibble(
Species = species_name,
survivorship_type = surv_type,
shape_value = shape_type
)
}) %>%
bind_rows()
# Step 4: Merge prevalence and survival metrics by Species
condensed_clean_data <- prevalence_clean_data %>%
left_join(survival_clean_metrics, by = "Species") %>%
select(
Species,
Class,
n,
neoplasia_prevalence,
cancer_prevalence,
survivorship_type,
shape_value
)
view(condensed_clean_data)
final_clean_data <- inner_join(condensed_data, condensed_clean_data, by = "Species")
view(final_clean_data)
final_clean_data <- condensed_data %>%
semi_join(condensed_clean_data, by = "Species")
view(final_clean_data)
write_csv(final_clean_data, "Spring 2025/final_clean_data.csv", row.names = FALSE)
write_csv(final_clean_data, file = "Spring 2025/final_clean_data.csv", row.names = FALSE)
view(final_clean_data)
write_csv(final_clean_data, "Spring 2025/final_clean_data.csv", row.names = FALSE)
write.csv(final_clean_data, "Spring 2025/final_clean_data.csv", row.names = FALSE)
