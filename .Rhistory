values = c("20-100" = 2,
"100-500" = 4,
"500-1000" = 6,
"1000+" = 8)
) +
theme_minimal() +
labs(
x = "Survivorship",
y = "Cancer Prevalence (%)",
color = "Class",
title = "Survivorship vs. Cancer Prevalence"
) +
theme(legend.position = "bottom")
