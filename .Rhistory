ld.v.siler_a3_neo <- signif(ld.v.siler_a3_neo[1], digits = 2)
p.v.siler_a3_neo <-summary(siler_a3_neo)$tTable
p.v.siler_a3_neo <-signif(p.v.siler_a3_neo[2,4], digits = 2)
ggplot(data, aes(x = a3, y = neoplasia_prevalence, color = Class, size = n)) +
geom_point(alpha = 1) +
scale_size_continuous(range = c(1, 5), guide = "none") +  # hide size legend
geom_abline(intercept = coef(siler_a3_neo)[1],
slope = coef(siler_a3_neo)[2],
color = 'grey', size = 1.2) +
theme_minimal() +
labs(
x = "Mortality Risk in the Senescent Stage (a3)",
y = "Neoplasia Prevalence (%)",
color = "Class"
) +
labs(
title = "Neoplasia Prevalence vs. Mortality Risk in the Senescent Stage (a3)",
subtitle = bquote(p-value:.(p.v.siler_a3_neo)~R^2:.(r.v.siler_a3_neo)~Lambda:.(ld.v.siler_a3_neo))
) +
theme_cowplot(12)
ggsave(filename='siler_a3_neo.png', width=10, height=8, limitsize=FALSE,bg="white")
siler_a3_cancer<-pglsSEyPagel(cancer_prevalence~a3,data=data,tree=pruned.tree,se=SE,method = "ML")
