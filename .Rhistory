download.packages("BaSTA")
install.packages("BaSTA")
library(BaSTA)
data("bastaCMRdat", package = "BaSTA")
siler_fit <- basta(object = bastaCMRdat,
model = "GO",            # Base model: Gompertz
shape = "bathtub",       # Adds juvenile and constant terms (Siler)
studyStart = 1970,       # Start year of the study
studyEnd = 2000,         # End year of the study
niter = 20000,           # Number of MCMC iterations
burnin = 2000,           # Initial iterations to discard
thinning = 50,           # Save every 50th iteration
nsim = 2,                # Number of parallel chains
parallel = FALSE)        # Set to TRUE if you have multiple cores
summary(siler_fit)
checkedData  <- DataCheck(bastaCMRdat, dataType = "CMR", studyStart = 51,
studyEnd = 70)
data("bastaCMRdat", package = "BaSTA")
multiout <- multibasta(bastaCMRdat, studyStart = 51, studyEnd = 70,
models = c("GO", "WE"), shapes = "simple",
niter = 100, burnin = 11, thinning = 10,
nsim = 1, updateJumps = FALSE, parallel = FALSE)
summary(multiout, digits = 3)
