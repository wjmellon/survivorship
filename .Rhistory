ggplot(data, aes(x = a2, y = cancer_prevalence, color = Class)) +
geom_point(alpha = 1, size = 1) +  # points
geom_smooth(method = "lm", se = TRUE, color = "black") +   # regression line
theme_minimal() +
labs(
x = "Age Independent Mortality",
y = "Cancer Prevalence (%)",
color = "Class",
title = "Cancer Prevalence vs Age Independent Mortality"
) +
theme(legend.position = "bottom")
